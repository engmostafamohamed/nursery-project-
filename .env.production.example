# PRODUCTION (future) — not live yet. Template only: names, no values. Never commit real values.
#
# Today the project runs on the DEV environment: `.env` (local) and the Vercel project
# "nursery-project" both point at the dev Supabase project hlhlpjecinkqqsqrjpcj.
#
# On the day XO goes live, production gets its OWN Supabase project and its OWN Vercel project.
# Put these values in that Vercel project (Settings -> Environment Variables -> Production),
# not in a local file. Server-side (Edge Function) secrets are in supabase/functions/.env.example.
# Full checklist: docs/environment-variables.md.

# Production Supabase project (must not be the dev project hlhlpjecinkqqsqrjpcj).
VITE_SUPABASE_URL=https://<production-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
# Only if `sb_publishable_*` keys return 401 on functions/v1 calls.
VITE_SUPABASE_LEGACY_ANON_KEY=

# Must be false in production: the login page must not list the demo accounts.
VITE_SHOW_DEMO_ACCOUNTS=false

# Browser push notifications (optional).
VITE_VAPID_PUBLIC_KEY=
