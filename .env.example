# Copy to .env and fill with your Supabase project (anon key only on the frontend).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_LEGACY_ANON_KEY=
VITE_SHOW_DEMO_ACCOUNTS=false
# Optional (ops scripts / Edge Functions): legacy JWT anon key from Supabase Dashboard → Settings → API → anon public.
# Use if `sb_publishable_*` keys return 401 Invalid JWT on `functions/v1` calls.
# For browser calls, set the same legacy anon JWT as VITE_SUPABASE_LEGACY_ANON_KEY.
SUPABASE_ANON_JWT=
# Optional: Personal Access Token from Supabase Dashboard → Account → Access Tokens (for `npm run ops:usage` only; never commit).
SUPABASE_ACCESS_TOKEN=
# AI assistant: calls Edge Function POST {VITE_SUPABASE_URL}/functions/v1/ai-assistant with the user JWT.
# Configure the provider API key in Supabase Dashboard → Edge Functions secrets (not in Vite).
# Web Push (optional). Run migration 054_user_push_subscriptions.sql so subscriptions can be stored.
VITE_VAPID_PUBLIC_KEY=
# Optional: min 12 chars. Used only by `npm run ops:cross-tenant` to sign in ephemeral RLS test parents.
RLS_CROSS_TENANT_TEST_PASSWORD=
# Optional: branch_admin (or chain/xo admin) used by `npm run ops:trigger-export` for E2E tenant export.
TENANT_EXPORT_TEST_EMAIL=
TENANT_EXPORT_TEST_PASSWORD=
