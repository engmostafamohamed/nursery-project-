# Edge Function secrets for production. Copy to supabase/functions/.env.production.local
# (ignored by git), fill in the values, then upload them all at once:
#
#   npx supabase secrets set --env-file supabase/functions/.env.production.local --project-ref <project-ref>
#
# Delete the lines you do not fill in: a part without its keys stays in demo mode.
# Details: docs/environment-variables.md

# --- Payments (Paymob) -------------------------------------------------------------------------
# Demo: SIGNUP_PAYMENT_TEST_MODE=true simulates card checkout. Production: false, and the rest set.
SIGNUP_PAYMENT_TEST_MODE=false
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_AMOUNT_MULTIPLIER=100
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_INSTAPAY_INTEGRATION_ID=
PAYMOB_MOBILE_WALLET_INTEGRATION_ID=
PAYMOB_FAWRY_INTEGRATION_ID=
# The app's public HTTPS address (Paymob returns here; links in emails point here).
APP_BASE_URL=

# --- Email (Resend) ----------------------------------------------------------------------------
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. XO Nursery <no-reply@your-domain.com>
EMAIL_FROM=

# --- SMS (SMS Misr) ----------------------------------------------------------------------------
SMS_MISR_USERNAME=
SMS_MISR_PASSWORD=
SMS_MISR_SENDER=
# 1 = live, 2 = SMS Misr's test environment
SMS_MISR_ENVIRONMENT=1

# --- WhatsApp (360dialog) ----------------------------------------------------------------------
WHATSAPP_360DIALOG_API_KEY=

# --- AI (Anthropic) ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional overrides; defaults: claude-haiku-5-5 (assistant), claude-sonnet-5-5 (import mapping)
ANTHROPIC_MODEL=
ANTHROPIC_IMPORT_MODEL=

# --- Optional ----------------------------------------------------------------------------------
# demo = never send email/SMS/WhatsApp even when the keys above are set (e.g. on staging)
MESSAGING_MODE=
